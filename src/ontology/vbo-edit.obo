format-version: 1.2
subsetdef: local_breed "refers to a breed reported in single country, as defined in DAD-IS (https://www.fao.org/dad-is)"
subsetdef: national_breed_population "refers to the instance of the transboundary breed in a particular country, as defined in DAD-IS (https://www.fao.org/dad-is)"
subsetdef: transboundary "refers to a breed reported in several different countries, as defined in DAD-IS (https://www.fao.org/dad-is)"
idspace: dce http://purl.org/dc/elements/1.1/ 
idspace: dcterms http://purl.org/dc/terms/ 
idspace: foaf http://xmlns.com/foaf/0.1/ 
idspace: oboInOwl http://www.geneontology.org/formats/oboInOwl# 
idspace: protege http://protege.stanford.edu/plugins/owl/protege# 
idspace: skos http://www.w3.org/2004/02/skos/core# 
idspace: swrla http://swrl.stanford.edu/ontologies/3.3/swrla.owl# 
import: http://purl.obolibrary.org/obo/vbo/components/axioms.owl
import: http://purl.obolibrary.org/obo/vbo/imports/cob_import.owl
import: http://purl.obolibrary.org/obo/vbo/imports/ncbitaxon_import.owl
import: http://purl.obolibrary.org/obo/vbo/imports/omo_import.owl
import: http://purl.obolibrary.org/obo/vbo/imports/ro_import.owl
import: http://purl.obolibrary.org/obo/vbo/imports/wikidata_import.owl
ontology: vbo
property_value: dcterms:description "Vertebrate Breed Ontology is an ontology created to serve as a single computable resource for vertebrate breed names." xsd:string
property_value: dcterms:license https://creativecommons.org/licenses/by/4.0/
property_value: dcterms:title "Vertebrate Breed Ontology" xsd:string
property_value: IAO:0000700 VBO:0300000
property_value: IAO:0000700 VBO:0400000

