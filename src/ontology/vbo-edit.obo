synonym: "Mutt" EXACT [] {source="https://orcid.org/0000-0002-5520-6597", source="https://orcid.org/0000-0002-9178-3965"}
synonym: "Native Dog" EXACT [] {source="https://orcid.org/0000-0002-5520-6597", source="https://orcid.org/0000-0002-9178-3965"}
