is_a: VBO:0001553 {source="https://www.fao.org/dad-is"} ! Podhale Zackel (Sheep)
is_a: VBO:0400000 {source="https://orcid.org/0000-0002-4142-7153", source="https://orcid.org/0000-0002-5002-8648"} ! Vertebrate breed
relationship: VBO:0300020 http://www.wikidata.org/entity/Q36 {source="https://www.fao.org/dad-is"} ! breed reported in geographic location
property_value: dcterms:contributor https://orcid.org/0000-0002-4142-7153
property_value: dcterms:contributor https://orcid.org/0000-0002-5520-6597
property_value: dcterms:contributor https://orcid.org/0000-0002-9178-3965
property_value: dcterms:source "https://www.fao.org/dad-is" xsd:anyURI
property_value: hasdomesticationstatus VBO:0300007 {source="https://www.fao.org/dad-is"}
property_value: origindescription "Podhale Zackels have been kept in Podhale, Podkarpacie and the Beskid Mountains region for ages. Tradition of breeding these sheep dates back to the periods of Wallachia-Russian pastoral tribes relocation along the chain of the Carpathian Mountains lasting from the 14th to 16th century. The white variety was bred only in the Podhale region and in the Western Carpathians. The dark (or black) variety was found mainly in the Eastern Carpathians and in the Eastern Ma√Ö‚Äöopolska region and its range reached beyond the pre-war Romanian border up to Transylvania and Bessarabia. Before the World War II the dark variety of Podhale Zackel was bred mostly in the Hucul region." xsd:string {source="https://www.fao.org/dad-is"}

