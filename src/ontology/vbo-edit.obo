synonym: "Random-Bred Dog" EXACT [] {source="https://orcid.org/0000-0002-5520-6597", synonymtypedef="most_common_name", source="https://orcid.org/0000-0002-9178-3965"}
synonym: "Street Dog" EXACT [] {source="https://orcid.org/0000-0002-5520-6597", source="https://orcid.org/0000-0002-9178-3965"}
synonym: "Village Dog" EXACT [] {source="https://orcid.org/0000-0002-5520-6597", source="https://orcid.org/0000-0002-9178-3965"}
